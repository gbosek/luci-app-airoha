#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

START=95
STOP=10
USE_PROCD=1

NAME=clients
PROBE=/usr/libexec/clients-probe
DNS=/usr/libexec/clients-dns
SNOOP=/usr/libexec/clients-snoop

# The DNS archive reads dnsmasq's own query log, and UCI carries the
# log-facility pointing at it. OpenWrt's stock /etc/dnsmasq.conf also ships an
# active log-facility line, and a second occurrence is a hard startup error on
# dnsmasq 2.93+ ("illegal repeated keyword") - dnsmasq ends up in a procd
# crash loop and DHCP dies for the whole LAN. postinst comments the stock line
# out, but a keep-config sysupgrade restores /etc/dnsmasq.conf verbatim and
# postinst never runs again, so start_service re-enforces the invariant on
# every boot, before procd's next dnsmasq retry lands.
fix_dnsmasq_conf() {
	local conf=/etc/dnsmasq.conf
	[ -e "$conf" ] || return 0
	grep -q '^log-facility=' "$conf" || return 0
	sed -i -e 's|^log-facility=|#&|' "$conf"
	/etc/init.d/dnsmasq restart 2>/dev/null
}

start_service() {
	fix_dnsmasq_conf

	local enabled interval retention path
	local dns_enabled dns_interval
	local snoop_enabled

	config_load clients
	config_get_bool enabled 'global' 'enabled' 1
	config_get interval 'global' 'interval' 30
	config_get retention 'global' 'retention' 7
	config_get path 'global' 'history_path' '/tmp/clients-history.json'
	config_get_bool dns_enabled 'dns' 'enabled' 1
	config_get dns_interval 'dns' 'interval' 10
	config_get_bool snoop_enabled 'snoop' 'enabled' 1

	[ "$enabled" = 1 ] || return 0

	# Retention is passed in rather than re-read from UCI by the probe: the
	# sampler owns the schedule, the page only consumes the result, and one
	# place for the setting avoids two answers to the same question.
	procd_open_instance "$NAME"
	procd_set_param command /bin/sh -c \
		"while true; do $PROBE collect '$path' $retention >/dev/null 2>&1; sleep $interval; done"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The DNS archive is a separate loop on purpose. It reads an append-only log
	# and its interval is bounded by how fresh the page should feel, not by the
	# cost of walking conntrack; tying the two would make one of them worse.
	[ "$dns_enabled" = 1 ] || return 0

	procd_open_instance "$NAME-dns"
	procd_set_param command /bin/sh -c \
		"while true; do $DNS collect >/dev/null 2>&1; sleep $dns_interval; done"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The snoop daemon is a real long-running process, not a loop: tcpdump
	# streams packets continuously and the kernel drops everything the BPF
	# filter does not want, so idle cost is a few pages of memory. Missing
	# tcpdump disables it quietly - the page falls back to what ARP sees.
	# On a router that owns its DHCP server the snoop adds nothing the lease
	# file does not already say, which is why the switch exists.
	[ "$snoop_enabled" = 1 ] || return 0
	[ -x "$SNOOP" ] || return 0
	[ -x /usr/bin/tcpdump ] || return 0

	procd_open_instance "$NAME-snoop"
	procd_set_param command "$SNOOP"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# The archive records first/last seen, so a wireless reload (SSID or radio
	# change) is worth a fresh round immediately instead of waiting a full
	# interval.
	procd_add_reload_trigger "clients"
	procd_add_reload_trigger "wireless"
}

reload_service() {
	stop
	start
}
