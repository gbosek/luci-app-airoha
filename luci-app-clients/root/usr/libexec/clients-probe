#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
'use strict';

/*
 * clients-probe - data source for the LuCI "Clients" page.
 *
 * Merges three views of the same population (LAN hosts) into one document keyed
 * by MAC:
 *
 *   addresses   ARP + IPv6 neighbour cache          who is reachable now
 *   rates       nf_conntrack byte counters          how much traffic, coarse
 *   wifi        iwinfo assoclist                    which AP/SSID, signal
 *   wifi_radios how many radios network.wireless has  has-WiFi flag
 *
 * No arguments prints a live snapshot and exits:
 *
 *   {
 *     "ts": 1792939457,
 *     "interfaces": [ { "iface": "lan2", "device": "br-lan.2", "vlan": 2,
 *                       "subnets": [ "10.10.20.0/24" ] } ],
 *     "arp":    [ { "ip": "10.10.20.93", "mac": "8E:5F:E7:18:85:E3",
 *                   "device": "br-lan.2" } ],
 *     "neigh6": [ { "ip": "2408:...", "mac": "58:CD:C9:C6:40:91",
 *                   "state": "STALE", "device": "br-lan.2" } ],
 *     "wifi":   { "8E:5F:E7:18:85:E3": { "ssid": "OPLT_5G", "ifname": "phy0.1-ap1",
 *                   "band": "5G", "signal": -35, "noise": -89 } },
 *     "traffic": { "10.10.20.93": { "up": 15744, "down": 2776, "conns": 2,
 *                   "device": "br-lan.2" } },
 *     "stats": { "conntrack": 860, "conntrack_max": 16384 },
 *     "bridge": { "mode": true, "uplink": "wan",
 *                 "members": [ "wan", "lan2" ],
 *                 "ports": { "wan": { "rx": 4926429178, "tx": 4101720363 },
 *                            "lan2": { "rx": 7101134, "tx": 13992952 } } },
 *     "nlbw_used": false,
 *     "snoop4": [ { "mac": "8E:5F:E7:18:85:E3", "ip": "10.10.20.93" } ],
 *     "snoop6": [ { "mac": "E8:68:B1:36:F4:75", "ip": "2408:...", "fresh": true } ]
 *   }
 *
 * `nlbw_used` is true when at least one host's traffic had to be taken from
 * nlbwmon because hardware flow offload had zeroed its conntrack byte counters.
 * nlbwmon reads the same driver accounting conntrack does, so the figures stay
 * correct for offloaded flows; on a box without it (or without offload) the
 * conntrack bytes are used unchanged and the flag stays false.
 *
 * `names` maps MAC -> hostname from the lease file, the luci-rpc hints and
 * the DHCP Host-Name option heard on the bridge, in that priority. On a
 * routed box one final PTR pass asks the local dnsmasq when the page is
 * being watched (the background collector passes it by); a bridging device
 * (AP mode) never queries anything.
 *
 * Subcommands:
 *
 *   clients-probe collect           sample, merge into the history file
 *   clients-probe read              print the history file
 *   clients-probe clear             empty the history file
 *   clients-probe status            history file summary
 *
 * The history is what makes the page more than a live view: first and last seen
 * survive a station going away, and the wireless association (SSID, band,
 * signal) survives a client roaming off this AP. It is written to /tmp on
 * purpose - a status page must not wear the flash - so it resets on reboot. The
 * page says so instead of pretending otherwise.
 *
 * Two design notes carried over from the ONU host list, both learned on target:
 *
 * 1. conntrack accounting keeps counting even for PPE-offloaded flows - the
 *    driver syncs the counters back. That is why the coarse path is still
 *    worth keeping on a PON gateway, where turning the offload off to get
 *    exact per-device rates would cost more than the measurement is worth.
 *
 * 2. Only resolved ARP entries are hosts. An incomplete entry keeps a zero MAC
 *    and would list every probe for a dead address as a client.
 */

let fs = require('fs');
import { connect } from 'ubus';

const ARP_FILE = '/proc/net/arp';
const LEASE_FILE = '/tmp/dhcp.leases';
const CONNTRACK_FILE = '/proc/net/nf_conntrack';
const CONNTRACK_COUNT = '/proc/sys/net/netfilter/nf_conntrack_count';
const CONNTRACK_MAX = '/proc/sys/net/netfilter/nf_conntrack_max';

const DEFAULT_HISTORY = '/tmp/clients-history.json';
const SNOOP_FILE = '/tmp/clients-snoop.json';

/* A passive observation this fresh counts as the host speaking right now.
 * Older observations keep attributing the address but stop marking the row
 * online - a duplicate-address probe from an hour ago is history, not
 * presence. */
const SNOOP_FRESH = 120;

/* ---------------- small helpers ---------------- */

function run(cmd) {
	let handle = fs.popen(cmd);
	let out;

	if (!handle)
		return '';

	try {
		out = handle.read('all');
	}
	catch (e) {
		out = null;
	}

	handle.close();

	return out ?? '';
}

function read(path) {
	let data;

	try {
		data = fs.readfile(path);
	}
	catch (e) {
		return '';
	}

	return data ?? '';
}

function is_hex(text, maxlen) {
	let len = length(text);

	if (len < 1 || len > maxlen)
		return false;

	for (let i = 0; i < len; i++) {
		let code = ord(text, i);

		if ((code < 48 || code > 57) && (code < 97 || code > 102))
			return false;
	}

	return true;
}

/* ---------------- address arithmetic ---------------- */

/*
 * Dotted-quad to integer in one pass. Splitting on '.' allocates an array of
 * four strings per address and this runs twice per conntrack entry; scanning the
 * characters directly costs one string walk and no allocation.
 */
function parse_v4(text) {
	let len = length(text ?? ''), value = 0, part = 0, digits = 0, parts = 0;

	for (let i = 0; i < len; i++) {
		let code = ord(text, i);

		if (code == 46) {
			if (digits == 0 || digits > 3 || part > 255)
				return null;

			value = value * 256 + part;
			part = 0;
			digits = 0;
			parts++;
			continue;
		}

		if (code < 48 || code > 57)
			return null;

		part = part * 10 + (code - 48);
		digits++;
	}

	if (parts != 3 || digits == 0 || digits > 3 || part > 255)
		return null;

	return value * 256 + part;
}

function format_v4(value) {
	return sprintf('%d.%d.%d.%d',
		int(value / 16777216) % 256,
		int(value / 65536) % 256,
		int(value / 256) % 256,
		value % 256);
}

function parse_v6(text) {
	let head, tail, words = [], filled, groups;

	text = lc(text ?? '');

	if (index(text, '.') >= 0) {
		/* Mixed form: only the trailing IPv4 part needs folding. */
		let cut = rindex(text, ':');
		let v4 = parse_v4(substr(text, cut + 1));

		if (v4 == null)
			return null;

		text = substr(text, 0, cut + 1)
			+ sprintf('%x:%x', int(v4 / 65536), v4 % 65536);
	}

	groups = split(text, '::');

	if (length(groups) > 2)
		return null;

	if (length(groups) == 1) {
		head = split(groups[0], ':');

		if (length(head) != 8)
			return null;

		tail = [];
		filled = 0;
	}
	else {
		head = (groups[0] == '') ? [] : split(groups[0], ':');
		tail = (groups[1] == '') ? [] : split(groups[1], ':');
		filled = 8 - length(head) - length(tail);

		if (filled < 0)
			return null;
	}

	for (let group in head) {
		if (!is_hex(group, 4))
			return null;

		push(words, hex(group));
	}

	for (let i = 0; i < filled; i++)
		push(words, 0);

	for (let group in tail) {
		if (!is_hex(group, 4))
			return null;

		push(words, hex(group));
	}

	return (length(words) == 8) ? words : null;
}

function format_v6(words) {
	let groups = [];

	for (let word in words)
		push(groups, sprintf('%x', word));

	return join(':', groups);
}

function subnet_v4(addr, mask) {
	let base = parse_v4(addr);

	if (base == null)
		return null;

	mask = (mask == null) ? 24 : int(mask);

	if (mask < 0 || mask > 32)
		return null;

	let size = (mask == 32) ? 1 : (1 << (32 - mask));
	let low = base - (base % size);

	/* A v4 subnet is a closed integer range; the conntrack loop only compares. */
	return {
		family: 4,
		lo: low,
		hi: low + size - 1,
		text: sprintf('%s/%d', format_v4(low), mask)
	};
}

function subnet_v6(addr, mask) {
	let words = parse_v6(addr);

	if (words == null)
		return null;

	mask = (mask == null) ? 64 : int(mask);

	if (mask < 0 || mask > 128)
		return null;

	for (let i = 0; i < 8; i++) {
		let bits = mask - i * 16;

		if (bits >= 16)
			continue;

		if (bits <= 0) {
			words[i] = 0;
			continue;
		}

		/* Keep the top `bits` bits of the word. */
		words[i] = words[i] & ((65535 << (16 - bits)) & 65535);
	}

	return {
		family: 6,
		words: words,
		mask: mask,
		text: sprintf('%s/%d', format_v6(words), mask)
	};
}

function in_subnet_v6(subnet, words) {
	for (let i = 0; i < 8; i++) {
		let bits = subnet.mask - i * 16;

		if (bits >= 16) {
			if (words[i] != subnet.words[i])
				return false;

			continue;
		}

		if (bits <= 0)
			return true;

		let keep = (65535 << (16 - bits)) & 65535;

		return (words[i] & keep) == subnet.words[i];
	}

	return true;
}

/* ---------------- LAN discovery ---------------- */

/*
 * Every interface named "lan" or "lanN" is a client-facing network. On a
 * multi-VLAN AP (six bridged VLANs is a real deployment here) that is six
 * networks with six subnets behind a single page, and the table needs to say
 * which one a client sits on - hence `vlan` in the output.
 *
 * The VLAN id comes from the device suffix (br-lan.3 -> 3) because that is what
 * the bridge is actually configured with; the interface name is only a fallback
 * for a deployment that names its bridges differently.
 */
function vlan_of(device, iface) {
	let m = match(device ?? '', /^[a-z0-9_-]+\.([0-9]+)$/);

	if (m)
		return int(m[1]);

	m = match(iface ?? '', /^lan([0-9]+)$/);

	if (m)
		return int(m[1]);

	return 0;
}

function lan_state() {
	let interfaces = [], local = [];
	let ubus = connect();

	if (!ubus)
		return { interfaces: interfaces, local: local };

	let dump = null;

	try {
		dump = ubus.call('network.interface', 'dump');
	}
	catch (e) {
		dump = null;
	}

	ubus.disconnect();

	for (let iface in (dump && dump.interface) ? dump.interface : []) {
		let name = iface.interface ?? '';

		/* "lan" and its numbered aliases only. The service bridges (br-iptv,
		 * ct-voice) and the WAN are excluded on purpose: this page answers
		 * "who is on my network", not "what did the router route". */
		if (name != 'lan' && !match(name, /^lan[0-9]+$/))
			continue;

		let device = iface.l3_device || iface.device;

		if (!device)
			continue;

		let subnets = [];

		for (let address in (iface['ipv4-address'] ?? [])) {
			let subnet = subnet_v4(address.address, address.mask);

			if (subnet)
				push(subnets, subnet);

			push(local, address.address);
		}

		for (let address in (iface['ipv6-address'] ?? [])) {
			push(local, address.address);

			/* A /128 host address says nothing about the prefix clients use. */
			if (address.mask == null || int(address.mask) >= 128)
				continue;

			let subnet = subnet_v6(address.address, address.mask);

			if (subnet)
				push(subnets, subnet);
		}

		push(interfaces, {
			iface: name,
			device: device,
			vlan: vlan_of(device, name),
			subnets: subnets
		});
	}

	return { interfaces: interfaces, local: local };
}

function device_names(interfaces) {
	let devices = [];

	for (let entry in interfaces)
		if (index(devices, entry.device) < 0)
			push(devices, entry.device);

	return devices;
}

function all_subnets(interfaces) {
	let subnets = [];

	for (let entry in interfaces)
		for (let subnet in entry.subnets)
			push(subnets, subnet);

	return subnets;
}

/* ---------------- neighbours ---------------- */

function arp_entries(devices) {
	let entries = [];
	let lines = split(trim(read(ARP_FILE)), '\n');

	/* ip, HW type, flags, MAC, mask, device - /proc/net/arp is stable. */
	for (let i = 1; i < length(lines); i++) {
		let fields = split(trim(lines[i]), /[ \t]+/);

		if (length(fields) < 6)
			continue;

		let ip = fields[0], flags = fields[2], mac = lc(fields[3]), device = fields[5];

		if (index(devices, device) < 0)
			continue;
		if (parse_v4(ip) == null)
			continue;

		/* ATF_COM (0x2) is the only flag that means "resolved": incomplete
		 * entries keep a zero MAC and would list every gateway probe as a
		 * host. The multicast bit excludes bridge-group noise. */
		if (!((hex(flags) ?? 0) & 2))
			continue;
		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/) || mac == '00:00:00:00:00:00')
			continue;
		if (hex(substr(mac, 0, 2)) % 2)
			continue;

		push(entries, { ip: ip, mac: uc(mac), device: device });
	}

	return entries;
}

/*
 * `ip -6 neigh show` is netlink-backed and prints one line per cache entry:
 *
 *   2408:8262:... dev br-lan lladdr 58:cd:c9:c6:40:91 STALE
 *    fe80::3a05:... dev br-lan FAILED
 *
 * Only entries that resolved to a link-layer address are hosts; FAILED and
 * INCOMPLETE rows are the other end of a failed probe and carry no lladdr.
 * Link-local addresses are skipped: they are per-interface, not per-host.
 */
function neighbour6(devices) {
	let entries = [];
	let lines = split(trim(run('ip -6 neigh show 2>/dev/null')), '\n');

	for (let line in lines) {
		let fields = split(trim(line), /[ \t]+/);
		let ip = fields[0], device = null, mac = null, state = '';

		if (ip == null || substr(ip, 0, 5) == 'fe80:')
			continue;

		for (let i = 1; i < length(fields); i++) {
			if (fields[i] == 'dev' && fields[i + 1] != null)
				device = fields[i + 1];
			else if (fields[i] == 'lladdr' && fields[i + 1] != null)
				/* Kept lower case until the shape check below: the pattern is
				 * written in one case, and the value is upper-cased after it so
				 * that both tables key clients the same way. */
				mac = lc(fields[i + 1]);
			else if (i + 1 == length(fields))
				state = fields[i];
		}

		if (device == null || mac == null || index(devices, device) < 0)
			continue;
		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			continue;

		push(entries, { ip: ip, mac: uc(mac), device: device, state: state });
	}

	return entries;
}

/* ---------------- DHCP leases ---------------- */

/*
 * dnsmasq's lease file is where a hostname survives after the client leaves:
 * the neighbour cache forgets it and the radio forgets it. The line format has
 * been stable for years:
 *
 *   1792940000 8e:5f:e7:18:85:e3 10.10.20.93 M2105K81C.lan 01:8e:5f:...
 *
 * A hostname of "*" means the client never sent one - a literal asterisk, not
 * an absence - so it is normalised to null here instead of leaking into a row.
 *
 * The file can be empty, and on this fleet often is: where DHCP is served
 * upstream (an AP behind a gateway) there is nothing to lease locally. The
 * second half of host_names() covers that case.
 */
function dhcp_leases() {
	let map = {};
	let lines = split(trim(read(LEASE_FILE)), '\n');

	for (let line in lines) {
		let fields = split(trim(line), /[ \t]+/);
		let mac = lc(fields[1] ?? '');
		let ip = fields[2] ?? '';
		let name = fields[3] ?? '';

		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			continue;

		if (name == '*' || name == '')
			name = null;

		map[uc(mac)] = { ip: ip, name: name };
	}

	return map;
}

/*
 * MAC -> hostname, from both places a name can come from. The lease file wins:
 * it is what this box actually handed out. luci-rpc's hints carry the rest -
 * names dnsmasq learned from DNS, from /etc/ethers, from the DHCP
 * configuration, or from a reverse lookup of a neighbour - and that object
 * exists on every image that runs this page, because the page itself needs it.
 *
 * Called as root from rpcd's exec path, so the ACL on the object does not apply
 * here; a failing rpcd simply costs the names, not the page.
 */
function host_names(leases) {
	let map = {};

	for (let mac in leases)
		if (leases[mac].name)
			map[mac] = leases[mac].name;

	let ubus = connect();

	if (!ubus)
		return map;

	let hints = null;

	try {
		hints = ubus.call('luci-rpc', 'getHostHints');
	}
	catch (e) {
		hints = null;
	}

	ubus.disconnect();

	/*
	 * Two shapes exist in the wild for this object: the raw rpcd answer is a
	 * flat map of MAC -> { ipaddrs, ip6addrs, name }, while LuCI's network
	 * module re-wraps it as { hosts: {...} }. Accept both rather than betting on
	 * one and silently losing every name on the other.
	 */
	let hosts = (hints && hints.hosts) ? hints.hosts : hints;

	if (hosts) {
		for (let mac in hosts) {
			let name = hosts[mac]?.name;

			if (name && map[uc(mac)] == null)
				map[uc(mac)] = name;
		}
	}

	return map;
}

/* ---------------- wireless association ---------------- */

/*
 * The AP knows something the ARP table never will: which radio a client is on,
 * under which SSID, and how strong the link is. On a multi-SSID box that is the
 * difference between "a host called android-1 is here" and "a phone is on the
 * 5 GHz guest network, -52 dBm".
 *
 * A client can appear on more than one VAP during a roam; the entry with the
 * strongest signal wins, because that is the one it is actually associated with.
 */
function band_of(freq) {
	let f = int(freq) ?? 0;

	if (f >= 5925 && f < 7125)
		return '6G';
	if (f >= 5150 && f < 5925)
		return '5G';
	if (f >= 2400 && f < 2500)
		return '2.4G';

	return null;
}

function wifi_state() {
	let map = {};
	let radios = 0;
	let ubus = connect();

	if (!ubus)
		return [ map, radios ];

	let status = null;

	try {
		status = ubus.call('network.wireless', 'status');
	}
	catch (e) {
		status = null;
	}

	if (!status) {
		ubus.disconnect();
		return [ map, radios ];
	}

	for (let radio in status) {
		let ifaces = status[radio]?.interfaces;

		if (!ifaces)
			continue;

		/* Counted before the per-interface work: a radio with an interface
		 * exists whether or not anyone associates, and "no radios" is what
		 * tells the devices page a Signal column can never mean anything. */
		radios++;

		for (let iface in ifaces) {
			let ifname = iface?.ifname;

			if (!ifname)
				continue;

			let info = null, assoc = null;

			try {
				info = ubus.call('iwinfo', 'info', { device: ifname });
				assoc = ubus.call('iwinfo', 'assoclist', { device: ifname });
			}
			catch (e) {
				continue;
			}

			if (!assoc?.results)
				continue;

			let ssid = info?.ssid ?? info?.essid ?? '';
			let band = band_of(info?.frequency) ?? iface?.config?.band ?? null;

			for (let bss in assoc.results) {
				let mac = bss?.mac;

				if (!mac)
					continue;

				let entry = {
					ssid: ssid,
					ifname: ifname,
					radio: radio,
					band: band,
					signal: int(bss?.signal) ?? 0,
					noise: int(bss?.noise) ?? 0
				};

				let key = uc(mac);
				let previous = map[key];

				if (previous && previous.signal >= entry.signal)
					continue;

				map[key] = entry;
			}
		}
	}

	ubus.disconnect();

	return [ map, radios ];
}

/* ---------------- conntrack accounting ---------------- */

/*
 * One nf_conntrack line holds the original tuple, then the reply tuple, as
 * `src= dst= ... bytes=` groups; both directions carry their own byte count, so
 * the classification below only has to find which side of the original tuple is
 * a LAN address.
 *
 * The line is aligned in columns, so splitting it on spaces produces a couple of
 * dozen tokens - most of them empty - per entry, and every intermediate table
 * costs an allocation. Scanning straight to the three keys we need avoids both.
 */
function split_tuple(line) {
	let family;

	if (substr(line, 0, 4) == 'ipv4')
		family = 4;
	else if (substr(line, 0, 4) == 'ipv6')
		family = 6;
	else
		return null;

	let len = length(line);
	let tuples = [], pos = 0;

	while (true) {
		let src_at = index(line, 'src=', pos);

		if (src_at < 0)
			break;

		let start = src_at + 4;
		let end = start;

		while (end < len && ord(line, end) != 32)
			end++;

		let src = substr(line, start, end - start);
		let dst = null, bytes = 0, cursor = end;

		let dst_at = index(line, 'dst=', end);

		if (dst_at >= 0) {
			start = dst_at + 4;
			end = start;

			while (end < len && ord(line, end) != 32)
				end++;

			dst = substr(line, start, end - start);
		}

		let bytes_at = index(line, 'bytes=', end);

		if (bytes_at >= 0) {
			start = bytes_at + 6;
			end = start;

			while (end < len && ord(line, end) != 32)
				end++;

			bytes = int(substr(line, start, end - start)) ?? 0;
			cursor = end;
		}

		push(tuples, { src: src, dst: dst, bytes: bytes });

		/* Skip past this tuple's own counters so the next src= is the reply. */
		pos = cursor;
	}

	return { family: family, tuples: tuples };
}

function in_any_v4(list, value) {
	for (let subnet in list)
		if (value >= subnet.lo && value <= subnet.hi)
			return true;

	return false;
}

function in_any_v6(list, words) {
	for (let subnet in list)
		if (in_subnet_v6(subnet, words))
			return true;

	return false;
}

/*
 * One flow, counted both in the client's total and in the scope it belongs to.
 *
 * The split is decided by the far end of the flow, not by the interface: a
 * conntrack entry does not record which interface it used, but it does record
 * both addresses, and "the other end is another LAN address" is exactly what
 * separates a client talking to a NAS from a client talking to the internet.
 * This is why the page can show LAN and WAN columns without the eBPF sampler
 * that would have required turning the flow offload off.
 */
function account(hosts, ip, up, down, scope) {
	let entry = hosts[ip] ?? {
		up: 0, down: 0, conns: 0,
		lan: { up: 0, down: 0, conns: 0 },
		wan: { up: 0, down: 0, conns: 0 }
	};

	entry.up += up;
	entry.down += down;
	entry.conns += 1;
	entry[scope].up += up;
	entry[scope].down += down;
	entry[scope].conns += 1;
	hosts[ip] = entry;
}

function traffic(subnets, local) {
	let hosts = {};
	let v4 = [], v6 = [];

	for (let subnet in subnets) {
		if (subnet.family == 4)
			push(v4, subnet);
		else
			push(v6, subnet);
	}

	let lines = split(trim(read(CONNTRACK_FILE)), '\n');

	for (let line in lines) {
		let flow = split_tuple(line);

		if (flow == null || length(flow.tuples) == 0)
			continue;

		let orig = flow.tuples[0];
		let reply = flow.tuples[1];
		let reply_bytes = reply ? reply.bytes : 0;

		if (orig.src == null || orig.dst == null)
			continue;

		if (index(local, orig.src) >= 0 || index(local, orig.dst) >= 0)
			/* The router's own addresses are inside the LAN subnet but are not
			 * hosts: DNS, DHCP and the LuCI session would otherwise show up as
			 * a client with a large connection count. */
			continue;

		if (flow.family == 4) {
			let src = parse_v4(orig.src);
			let dst = parse_v4(orig.dst);

			if (src == null || dst == null)
				continue;

			let is_src = in_any_v4(v4, src);
			let is_dst = in_any_v4(v4, dst);

			if (is_src)
				account(hosts, orig.src, orig.bytes, reply_bytes,
					in_any_v4(v4, dst) ? 'lan' : 'wan');
			else if (is_dst)
				account(hosts, orig.dst, reply_bytes, orig.bytes,
					in_any_v4(v4, src) ? 'lan' : 'wan');
		}
		else {
			let src = parse_v6(orig.src);
			let dst = parse_v6(orig.dst);

			if (src == null || dst == null)
				continue;

			let is_src = in_any_v6(v6, src);
			let is_dst = in_any_v6(v6, dst);

			if (is_src)
				account(hosts, orig.src, orig.bytes, reply_bytes,
					in_any_v6(v6, dst) ? 'lan' : 'wan');
			else if (is_dst)
				account(hosts, orig.dst, reply_bytes, orig.bytes,
					in_any_v6(v6, src) ? 'lan' : 'wan');
		}
	}

	return hosts;
}

function conntrack_stats() {
	let count = int(trim(read(CONNTRACK_COUNT))) ?? 0;
	let max = int(trim(read(CONNTRACK_MAX))) ?? 0;

	return { conntrack: count, conntrack_max: max };
}

/* ---------------- bridge port counters ---------------- */

/*
 * Byte counters of every bridge member, straight from the kernel: the DSA
 * ports report the switch hardware counters, the wireless netdevs count
 * everything their radio moved.
 *
 * On a routed box these add nothing conntrack does not say better. On a
 * bridging device they are the only traffic figure that survives the offload:
 * the flows are still tracked, but the PPE answers the packets and the
 * conntrack accounting stays at zero - verified on target, where a wireless
 * client showed 223 WAN flows and not one counted byte. The overview reads
 * these instead when the device turns out to be a bridge.
 *
 * A bridge member named "wan" is what marks that mode: on a router the wan
 * port is routed and never a bridge member, so finding one inside a brif
 * means the uplink was bridged into the LAN - an AP. Its counters are the
 * WAN figure; the sum of the other members, minus what crossed the uplink,
 * is the traffic between this device's own clients.
 */
function port_counters() {
	let lines = split(trim(run(
		'for d in /sys/class/net/*; do [ -d "$d/brif" ] && for m in "$d"/brif/*; do echo "$(basename "$d") $(basename "$m")"; done; done 2>/dev/null'
	)), '\n');
	let ports = {};
	let members = [];
	let uplink = null;

	for (let line in lines) {
		let parts = split(trim(line), ' ');

		if (length(parts) != 2)
			continue;

		let member = parts[1];

		if (ports[member] != null)
			continue;

		let rx = int(trim(read('/sys/class/net/' + member + '/statistics/rx_bytes')));
		let tx = int(trim(read('/sys/class/net/' + member + '/statistics/tx_bytes')));

		if (rx == null || tx == null)
			continue;

		ports[member] = { rx: rx, tx: tx };
		push(members, member);

		if (member == 'wan')
			uplink = member;
	}

	return {
		mode: uplink != null,
		uplink: uplink,
		members: members,
		ports: ports
	};
}

/* ---------------- nlbwmon long-term counters ---------------- */

/*
 * nlbwmon is the long-term counter this page does not try to reinvent. It
 * listens on the conntrack netlink socket, so it sees a stream twice - when it
 * is created and, more importantly, when it is destroyed, with the final byte
 * counts attached - and it refreshes the counters of still-established streams
 * every 30 seconds.
 *
 * A timer that samples /proc/net/nf_conntrack can never do that. Measured on
 * this fleet: five seconds of ordinary traffic retired enough rows to drop the
 * table total from 1,059,211 to 1,057,753 bytes. A stream that opens and closes
 * between two samples is simply invisible, so sampling can only ever produce a
 * floor - which is exactly what the live columns in the page say they are.
 *
 * nlbwmon also keeps working with the hardware offload on, because it reads the
 * same accounting counters the driver writes back for PPE-offloaded flows.
 *
 * It is optional. Without /usr/sbin/nlbw the live counters still work and every
 * long-term column stays empty - the page does not fail.
 */
const NLBW = '/usr/sbin/nlbw';

function nlbw_available() {
	return length(trim(run('test -x ' + NLBW + ' && echo yes'))) > 0;
}

function nlbw_usage(period) {
	let cmd = NLBW + ' -c json';

	if (period != null && length(period))
		cmd += ' -t ' + period;

	/* Group by MAC alone: the page joins on MAC, and grouping by ip or layer7 as
	 * well would split one device into several rows that this function would
	 * then have to add back together anyway. */
	cmd += ' -g mac -o -rx_bytes,-tx_bytes';

	let raw = run(cmd + ' 2>/dev/null');
	let data = null;

	try {
		data = json(raw);
	}
	catch (e) {
		return null;
	}

	if (data == null || type(data.columns) != 'array' || type(data.data) != 'array')
		return null;

	/*
	 * nlbw reports the column names as an array and the rows positionally:
	 *
	 *   {"columns":["mac","conns","rx_bytes","rx_pkts","tx_bytes","tx_pkts"],
	 *    "data":[["04:56:65:8a:2e:85",22,1676260,611,90173,502]]}
	 *
	 * The order is whatever -g asked for, so the name -> position map has to be
	 * built rather than assumed. Reading columns.mac off an array yields
	 * undefined and every field silently reads as zero, which is exactly how
	 * this looked like "no traffic" on the first run against a live nlbwmon.
	 */
	let index = {};

	for (let i = 0; i < length(data.columns); i++)
		index[data.columns[i]] = i;

	let map = {};

	for (let record in data.data) {
		let mac = record[index.mac] ?? '';

		if (type(mac) != 'string' || !match(lc(mac), /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			continue;
		if (lc(mac) == '00:00:00:00:00:00')
			continue;

		let key = uc(mac);
		let entry = map[key] ?? { up: 0, down: 0, conns: 0 };

		/* rx_bytes is what arrived at the local network - a download for the
		 * client; tx_bytes is what left it. Verified against a live device:
		 * 1.67 MB rx against 90 KB tx for a host that mostly downloads. */
		entry.down += int(record[index.rx_bytes] ?? 0) ?? 0;
		entry.up += int(record[index.tx_bytes] ?? 0) ?? 0;

		if (index.conns != null)
			entry.conns += int(record[index.conns] ?? 0) ?? 0;

		map[key] = entry;
	}

	return map;
}

/*
 * Fold nlbwmon's per-MAC byte counters into the conntrack-driven traffic map.
 *
 * Some platforms hardware-offload flows (the `[HW_OFFLOAD]` tag in
 * /proc/net/nf_conntrack) and the offload driver does NOT write the byte
 * counters back into the conntrack entry - every offloaded flow reads
 * bytes=0, so a routed box that leans on the offload shows a "Clients" table
 * where every host has zero traffic. nlbwmon listens on the same conntrack
 * netlink socket the driver reports into, so it still accumulates the bytes
 * (and the flow count) for those offloaded streams.
 *
 * The merge is keyed through the address-to-MAC tables already built for the
 * PTR pass, so the page's existing rate/total differentiation needs no change:
 * nlbwmon's rx_bytes is what the client received (download), tx_bytes what it
 * sent (upload), and both go into the WAN bucket because nlbwmon groups by MAC
 * alone and cannot tell LAN from WAN. The LAN half is left at zero; Total
 * still adds up to the WAN figure, which for an internet client is the number
 * that matters.
 *
 * Where conntrack byte accounting is already non-zero (no offload, or a
 * bridging AP whose port counters already cover it) this is a no-op, so the
 * original path is left untouched and the LAN/WAN split it computes survives.
 */
function nlbw_into_traffic(hosts, ipMac) {
	if (!nlbw_available())
		return false;

	/*
	 * A box with hardware offload is a mix, not an all-or-nothing: some flows
	 * are tracked (conntrack bytes intact) and some are offloaded (bytes=0,
	 * entry still present). So the decision is per-host - fill a host's bytes
	 * from nlbwmon only when its own conntrack bytes are zero - rather than a
	 * global "all conntrack zero" gate that would miss exactly the offloaded
	 * hosts this exists to rescue (on 30.1 ~1252 of ~1700 entries read
	 * bytes=0 while the rest still count).
	 */
	let usage = nlbw_usage(null);

	if (usage == null)
		return false;

	/* A single client MAC answers on several addresses - an IPv4 lease and
	 * the EUI-64 IPv6 derived from the same MAC are the common case. The
	 * reverse map must therefore be MAC -> [all its IPs], not MAC -> one IP,
	 * or only the last address would inherit the nlbwmon bytes and the IPv4
	 * (or IPv6) sibling would stay at zero. */
	let mac_ips = {};

	for (let ip in ipMac)
		if (ipMac[ip]) {
			let m = ipMac[ip];

			if (mac_ips[m] == null)
				mac_ips[m] = [];

			push(mac_ips[m], ip);
		}

	let used = false;

	for (let key, entry in usage) {
		let ips = mac_ips[key];

		if (ips == null)
			continue;

		let conntrack_total = 0;

		for (let ip in ips)
			conntrack_total += (hosts[ip]?.up || 0) + (hosts[ip]?.down || 0);

		let nlbw_total = (entry.up || 0) + (entry.down || 0);

		/* nlbwmon accumulates the same driver accounting conntrack reads, so
		 * it is always a superset - it never loses flows that opened and
		 * closed between two /proc snapshots. Use it only when conntrack is
		 * clearly missing the device (zero bytes, or a sliver next to
		 * nlbwmon's total, which is what a few non-offloaded flows leave
		 * behind on an otherwise offloaded host). Otherwise keep conntrack,
		 * which still carries the LAN/WAN split. */
		if (nlbw_total <= 0 || nlbw_total <= conntrack_total * 2)
			continue;

		/* The device is offloaded. Carry nlbwmon's MAC-wide total on a single
		 * address - preferring IPv4 so the WAN figure lands beside the
		 * connection count - and leave the other addresses at their (zero)
		 * conntrack counters. The page then sums exactly one copy instead of
		 * multiplying the same total over every address of a dual-stack host. */
		let rep = null;

		for (let ip in ips)
			if (index(ip, ':') < 0) {
				rep = ip;
				break;
			}

		if (rep == null)
			rep = ips[0];

		let h = hosts[rep];

		if (h == null) {
			h = {
				up: 0, down: 0, conns: 0,
				lan: { up: 0, down: 0, conns: 0 },
				wan: { up: 0, down: 0, conns: 0 }
			};
			hosts[rep] = h;
		}

		/* rx_bytes = client received = download; tx_bytes = client sent =
		 * upload. Verified against a live device. The LAN/WAN split is gone
		 * (nlbwmon groups by MAC alone) so both bytes go to WAN; LAN stays
		 * zero. Connections keep coming from conntrack - the concurrent-flow
		 * count, matching the 20.1 reference - so nlbwmon's lifetime conn
		 * count is only used when conntrack recorded nothing for this
		 * address. */
		h.up = entry.up;
		h.down = entry.down;
		h.wan.up = entry.up;
		h.wan.down = entry.down;
		h.lan.up = 0;
		h.lan.down = 0;

		/* conntrack under-reports a device whose flows are offloaded - their
		 * entries drop out - so its concurrent count is tiny right where the
		 * bytes are. Since nlbwmon is already authoritative for this device's
		 * traffic, take its connection count too, so the bytes and the
		 * connection column agree on which source described the device. */
		if (entry.conns)
			h.conns = entry.conns;

		used = true;
	}

	return used;
}

/*
 * The accounting periods nlbwmon has on disk, oldest first. The configured
 * interval decides what a period means - the package default starts a new one
 * on the first of every month, which is what the page labels it as.
 */
function nlbw_periods() {
	let list = [];
	let lines = split(trim(run(NLBW + ' -c list 2>/dev/null')), '\n');

	for (let line in lines) {
		let text = trim(line);

		if (match(text, /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))
			push(list, text);
	}

	return list;
}

/* ---------------- snapshot ---------------- */

/* ucode initialises top-level functions in statement order, so the helpers a
 * function calls must be declared above it. */
function valid_mac_text(text) {
	if (type(text) != 'string' || !match(lc(text), /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
		return null;

	if (lc(text) == '00:00:00:00:00:00')
		return null;

	return uc(text);
}

function valid_ip4_text(text) {
	if (type(text) != 'string' || !match(text, /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/))
		return null;

	for (let part in split(text, '.'))
		if (int(part) > 255)
			return null;

	return text;
}

/*
 * Read what clients-snoop learned by listening on the bridge. On a bridging
 * device (AP mode) the local daemon stack owns no addresses: dnsmasq leases
 * nothing, the kernel never resolves a client's global IPv6 address, and the
 * only place the assignments are visible is the traffic crossing the bridge.
 * The snoop file carries that - DHCPACK assignments per MAC and IPv6
 * addresses learned from neighbour discovery - plus the Host-Name option the
 * clients themselves sent, keyed by MAC. The names are not freshness-gated:
 * a hostname learned three days ago is still the best answer for that MAC,
 * which is exactly why the lease file is read the same way.
 */
function snoop_state() {
	let raw = read(SNOOP_FILE);
	let parsed = null;

	if (!length(raw))
		return null;

	try {
		parsed = json(raw);
	}
	catch (e) {
		parsed = null;
	}

	if (parsed == null || type(parsed) != 'object')
		return null;

	let dhcp4 = (type(parsed.dhcp4) == 'object') ? parsed.dhcp4 : {};
	let hosts6 = (type(parsed.hosts6) == 'object') ? parsed.hosts6 : {};
	let snoop4 = [];
	let snoop6 = [];
	let names = {};
	let cutoff = time() - SNOOP_FRESH;

	for (let mac, entry in dhcp4) {
		let hw = valid_mac_text(mac);

		if (hw == null || valid_ip4_text(entry?.ip) == null)
			continue;

		push(snoop4, { mac: hw, ip: entry.ip });
	}

	for (let mac, host in hosts6) {
		let hw = valid_mac_text(mac);

		if (hw == null || type(host) != 'object')
			continue;

		for (let ip, ts in host) {
			if (index(ip, ':') < 0)
				continue;

			push(snoop6, {
				mac: hw,
				ip: ip,
				fresh: (int(ts) ?? 0) >= cutoff
			});
		}
	}

	if (type(parsed.names) == 'object')
		for (let mac, entry in parsed.names) {
			let hw = valid_mac_text(mac);
			let name = entry?.name;

			if (hw == null || type(name) != 'string' || !length(name))
				continue;

			names[hw] = name;
		}

	return { snoop4: snoop4, snoop6: snoop6, names: names };
}

/* ---------------- PTR hostnames ---------------- */

/*
 * The passive sources are slow by nature: the lease file only exists where
 * this box runs dnsmasq, the Host-Name option only crosses the bridge when a
 * client happens to renew. On a routed box the one source that answers
 * immediately is DNS itself - this box's own dnsmasq registers every lease
 * it hands out under in-addr.arpa, so a reverse query for a client address
 * returns its hostname.
 *
 * The whole pass is skipped on a bridging device (AP mode): there the
 * answering server would be the upstream router, and an AP does not get to
 * ask the network for names - it only listens. On a router the device's own
 * LAN addresses come first in the candidate list, so the queries stay local
 * even when resolv.conf.auto names upstream resolvers as fallback.
 * Everything is cached with a TTL (short for NXDOMAIN, so a client that
 * later obtains a lease is noticed), and a run queries at most a handful of
 * names: a busy table costs a few cycles, never a burst.
 */
const PTR_CACHE = '/tmp/clients-ptr.json';
const PTR_TTL_POS = 6 * 3600;
const PTR_TTL_NEG = 600;
const PTR_QUERIES_PER_RUN = 8;

function ptr_cache_load() {
	let raw = read(PTR_CACHE);
	let parsed = null;

	if (length(raw))
		try {
			parsed = json(raw);
		}
		catch (e) {
			parsed = null;
		}

	if (parsed == null || type(parsed) != 'object' || type(parsed.ptr) != 'object')
		return { server: null, server_ts: 0, ptr: {} };

	return parsed;
}

function ptr_cache_save(cache) {
	let text = sprintf('%J\n', cache);

	if (fs.writefile(PTR_CACHE + '.new', text) == length(text)) {
		try {
			fs.chmod(PTR_CACHE + '.new', 0600);
		}
		catch (e) {}

		fs.rename(PTR_CACHE + '.new', PTR_CACHE);
	}
}

/* Where to ask: the device's own LAN addresses first (that is where a local
 * dnsmasq listens), then every non-loopback resolver the resolv files name. */
function dns_servers(local) {
	let list = [];

	for (let ip in local)
		if (match(ip, /^[0-9.]+$/) && index(list, ip) < 0)
			push(list, ip);

	let lines = split(read('/tmp/resolv.conf.d/resolv.conf.auto') + '\n' + read('/etc/resolv.conf'), '\n');

	for (let line in lines) {
		let ns = match(line, /^nameserver[ \t]+([0-9a-fA-F.:]+)/);

		if (ns == null)
			continue;

		let server = ns[1];

		if (match(server, /^127\.|^0\.0\.0\.0$|^255\.|^fe80/) || server == '::1')
			continue;

		if (index(list, server) < 0)
			push(list, server);
	}

	return list;
}

function search_domains() {
	let domains = [];
	let lines = split(read('/tmp/resolv.conf.d/resolv.conf.auto') + '\n' + read('/etc/resolv.conf'), '\n');

	for (let line in lines) {
		let m = match(line, /^search[ \t]+(.+)$/);

		if (m == null)
			continue;

		for (let d in split(trim(m[1]), /[ \t]+/))
			if (match(d, /^[A-Za-z0-9._-]+$/) && index(domains, d) < 0)
				push(domains, d);
	}

	return domains;
}

/* Strip the trailing dot and the search domain, then keep only names a page
 * can print - tcpdump's escaping rule applies to DNS answers just the same. */
function ptr_clean(text, domains) {
	if (type(text) != 'string')
		return null;

	text = trim(text);

	while (length(text) > 1 && substr(text, length(text) - 1) == '.')
		text = substr(text, 0, length(text) - 1);

	for (let d in domains) {
		let suffix = '.' + d;

		if (length(text) > length(suffix) && substr(text, length(text) - length(suffix)) == suffix)
			text = substr(text, 0, length(text) - length(suffix));
	}

	let len = length(text);

	if (len < 1 || len > 64)
		return null;

	for (let i = 0; i < len; i++) {
		let code = ord(text, i);

		if (code < 32 || code > 126 || code == 92)
			return null;
	}

	return text;
}

/* One reverse query, walking the server candidates until one answers. A
 * definitive NXDOMAIN is an answer too ('' = negative, cached briefly); a
 * server that never replies is skipped and the remembered one is dropped. */
function ptr_query(ip, servers, domains, cache) {
	let start = 0;

	for (let i = 0; i < length(servers); i++)
		if (servers[i] == cache.server)
			start = i;

	for (let i = 0; i < length(servers); i++) {
		let server = servers[(start + i) % length(servers)];
		let out = run('timeout 3 nslookup ' + ip + ' ' + server + ' 2>/dev/null');
		let ans = null;

		if (out != null && length(out)) {
			ans = match(out, /in-addr\.arpa[ \t]+name[ \t]*=[ \t]*([A-Za-z0-9._-]+)/) ??
				match(out, /[ \t]name[ \t]*=[ \t]*([A-Za-z0-9._-]+)/);

			if (ans == null && match(out, /NXDOMAIN/)) {
				cache.server = server;
				cache.server_ts = time();

				return '';
			}

			if (ans != null) {
				cache.server = server;
				cache.server_ts = time();

				return ptr_clean(ans[1], domains);
			}
		}
	}

	/* Nothing answered: forget the remembered server so the next query
	 * starts from the top of the candidate list. */
	cache.server = null;

	return null;
}

/* Fill names the lease file, the hints and the wire left open, keyed through
 * the address-to-MAC tables this snapshot already built. */
function ptr_names(names, ipMac, candidates, local) {
	if (!length(candidates))
		return;

	let servers = dns_servers(local);

	if (!length(servers))
		return;

	let cache = ptr_cache_load();
	let domains = search_domains();
	let now = time();
	let budget = PTR_QUERIES_PER_RUN;
	let changed = false;

	for (let ip in candidates) {
		let mac = ipMac[ip];

		if (mac == null || names[mac] != null)
			continue;

		let hit = cache.ptr[ip];
		let name;

		if (hit != null && type(hit.name) == 'string' &&
		    (now - (int(hit.ts) ?? 0)) < ((hit.name == '') ? PTR_TTL_NEG : PTR_TTL_POS)) {
			name = hit.name;
		}
		else if (budget > 0) {
			budget--;

			name = ptr_query(ip, servers, domains, cache);

			if (name == null)
				continue;

			cache.ptr[ip] = { name: name, ts: now };
			changed = true;
		}
		else {
			continue;
		}

		if (name != '')
			names[mac] = name;
	}

	/* The cache follows the same bound as the snoop tables. */
	let ips = keys(cache.ptr);

	while (length(ips) > 512) {
		let oldest = null;
		let oldest_at = 0;

		for (let i = 0; i < length(ips); i++) {
			let at = int(cache.ptr[ips[i]]?.ts) ?? 0;

			if (oldest == null || at < oldest_at) {
				oldest = ips[i];
				oldest_at = at;
			}
		}

		if (oldest == null)
			break;

		delete cache.ptr[oldest];
		ips = keys(cache.ptr);
		changed = true;
	}

	if (changed)
		ptr_cache_save(cache);
}

function snapshot(withPtr) {
	let lan = lan_state();
	let devices = device_names(lan.interfaces);
	let arp = arp_entries(devices);
	let neigh6 = neighbour6(devices);
	let hosts = traffic(all_subnets(lan.interfaces), lan.local);
	let wifi = wifi_state();
	let wifiMap = wifi[0];
	let wifiRadios = wifi[1];
	let leases = dhcp_leases();
	let names = host_names(leases);
	let snoop = snoop_state();
	let bridge = port_counters();

	/* Names the clients reported themselves (DHCP option 12, heard on the
	 * bridge) fill the gaps the lease file and the hints leave open - which
	 * on a bridging device is all of them, since neither source exists
	 * there. A locally served lease outranks what was overheard, so snoop
	 * only ever completes the map, never overrides it. */
	for (let mac, name in snoop?.names ?? {})
		if (names[mac] == null)
			names[mac] = name;

	/* Last source, first answer - and only when someone is watching. The
	 * page pulls this live snapshot every few seconds, so the pass runs
	 * there, driven by the viewer; the background collector passes false
	 * and never spawns an nslookup. On a bridging device (AP mode) it is
	 * skipped even here: the answering server would be the upstream router,
	 * and an AP does not ask the network for names - it listens to the wire
	 * (the DHCP Host-Name option above) and accepts what it hears. The
	 * cache TTLs keep a watched page from re-asking names it already
	 * resolved. */
	let ipMac = {};

	for (let entry in arp)
		if (ipMac[entry.ip] == null)
			ipMac[entry.ip] = entry.mac;

	for (let entry in (snoop?.snoop4 ?? []))
		if (ipMac[entry.ip] == null)
			ipMac[entry.ip] = entry.mac;

	for (let entry in (snoop?.snoop6 ?? []))
		if (ipMac[entry.ip] == null)
			ipMac[entry.ip] = entry.mac;

	/* Where the offload has zeroed conntrack's byte counters, replace them with
	 * nlbwmon's offload-safe per-MAC bytes so the page shows real traffic. No
	 * nlbwmon, or conntrack already counting, leaves this a no-op. */
	let nlbw_used = nlbw_into_traffic(hosts, ipMac);

	let candidates = [];

	for (let ip in ipMac)
		if (index(lan.local, ip) < 0)
			push(candidates, ip);

	if (withPtr && !bridge.mode)
		ptr_names(names, ipMac, candidates, lan.local);

	/* Every address ARP resolved belongs in the answer even with zero counters,
	 * so the page can list a host that has not spoken yet. The scope sub-objects
	 * are created here too: the page reads them unconditionally. */
	for (let entry in arp)
		if (hosts[entry.ip] == null)
			hosts[entry.ip] = {
				up: 0, down: 0, conns: 0,
				lan: { up: 0, down: 0, conns: 0 },
				wan: { up: 0, down: 0, conns: 0 }
			};

	/*
	 * Carry the hostname on the ARP row. The page could look names up itself,
	 * but doing it once here means the row is named even on the first render,
	 * and the same table feeds the archive two functions down.
	 */
	for (let entry in arp)
		if (entry.name == null && names[entry.mac] != null)
			entry.name = names[entry.mac];

	/* Tag each counter row with the network it arrived on. conntrack does not
	 * say which interface a flow used, but the neighbour cache does for the same
	 * address - falling back to the IPv6 cache for a v6-only host. */
	let deviceOf = {};

	for (let entry in arp)
		deviceOf[entry.ip] = entry.device;
	for (let entry in neigh6)
		if (deviceOf[entry.ip] == null)
			deviceOf[entry.ip] = entry.device;

	for (let ip in hosts)
		if (deviceOf[ip] != null)
			hosts[ip].device = deviceOf[ip];

	let networks = [];

	for (let entry in lan.interfaces) {
		let subnets = [];

		for (let subnet in entry.subnets)
			push(subnets, subnet.text);

		push(networks, {
			iface: entry.iface,
			device: entry.device,
			vlan: entry.vlan,
			subnets: subnets
		});
	}

	return {
		ts: time(),
		interfaces: networks,
		arp: arp,
		neigh6: neigh6,
		wifi: wifiMap,
		wifi_radios: wifiRadios,
		names: names,
		traffic: hosts,
		stats: conntrack_stats(),
		bridge: {
			mode: bridge.mode,
			uplink: bridge.uplink,
			members: bridge.members,
			ports: bridge.ports
		},
		nlbw_used: nlbw_used,
		snoop4: snoop?.snoop4 ?? [],
		snoop6: snoop?.snoop6 ?? []
	};
}

/* ---------------- history ---------------- */

function history_empty() {
	return { version: 1, updated: 0, clients: {} };
}

function history_load(path) {
	let raw = read(path);

	if (!length(raw))
		return history_empty();

	let data = null;

	try {
		data = json(raw);
	}
	catch (e) {
		data = null;
	}

	/* A truncated or foreign file is replaced rather than appended to: the
	 * archive restarts, which is visible in the page, while a broken file would
	 * otherwise be rewritten on every collection. */
	if (data == null || type(data.clients) != 'object')
		return history_empty();

	return data;
}

function mkdirp(dir) {
	let parts = split(dir, '/'), current = '';

	for (let part in parts) {
		if (part == '')
			continue;

		current += '/' + part;

		try {
			fs.mkdir(current);
		}
		catch (e) {
			/* Already there, or not ours to create. The write below reports the
			 * real problem if the directory is still missing. */
		}
	}
}

function history_write(path, data) {
	let text = sprintf('%J\n', data);
	let cut = rindex(path, '/');

	if (cut > 0)
		mkdirp(substr(path, 0, cut));

	if (fs.writefile(path + '.new', text) != length(text))
		return false;

	try {
		fs.chmod(path + '.new', 0600);
	}
	catch (e) {}

	return fs.rename(path + '.new', path) ? true : false;
}

/*
 * Merge one snapshot into the archive. Records are keyed by MAC, which is the
 * only identifier all three sources share; a host seen only in the neighbour
 * cache is still worth an archive row, because that is what makes "last seen"
 * answerable after it leaves.
 *
 * Online means "reachable right now": ARP resolved it, the IPv6 cache has a
 * link-layer address for it, or the radio lists it as associated. A row that is
 * neither is kept with online=false until retention drops it.
 */
function history_merge(path, snap, retention) {
	let data = history_load(path);
	let now = snap.ts;
	let seen = {};
	let changed = false;

	function touch(mac, patch) {
		if (!mac)
			return;

		let entry = data.clients[mac];

		if (!entry) {
			entry = { mac: mac, first: now, online: false };
			data.clients[mac] = entry;
		}

		for (let key in patch) {
			let value = patch[key];

			if (value != null && value !== '')
				entry[key] = value;
		}

		entry.last = now;
		seen[mac] = true;
		changed = true;

		return entry;
	}

	for (let neighbour in snap.arp)
		touch(neighbour.mac, {
			ip4: neighbour.ip,
			device: neighbour.device,
			name: neighbour.name,
			online: true
		});

	for (let neighbour in snap.neigh6)
		touch(neighbour.mac, { ip6: neighbour.ip, online: true });

	for (let mac in snap.wifi) {
		let assoc = snap.wifi[mac];

		touch(mac, {
			ssid: assoc.ssid,
			ifname: assoc.ifname,
			band: assoc.band,
			signal: assoc.signal,
			noise: assoc.noise,
			online: true
		});
	}

	/* Anything not seen in this round is offline, not gone. The distinction is
	 * the whole point of keeping the archive. */
	for (let mac in data.clients) {
		let entry = data.clients[mac];

		if (seen[mac]) {
			entry.online = true;
			continue;
		}

		if (entry.online) {
			entry.online = false;
			changed = true;
		}
	}

	/*
	 * A name outlives the station's presence, so it can still label a row that
	 * was recorded before the name was known. This never creates a row: a stale
	 * name must not resurrect a client the retention policy has already dropped.
	 */
	for (let mac in (snap.names ?? {})) {
		let name = snap.names[mac];
		let entry = data.clients[mac];

		if (!entry || entry.name || !name)
			continue;

		entry.name = name;
		changed = true;
	}

	if (retention > 0) {
		let cutoff = now - retention * 86400;
		let stale = [];

		for (let mac in data.clients)
			if ((int(data.clients[mac].last) ?? 0) < cutoff)
				push(stale, mac);

		for (let mac in stale) {
			delete data.clients[mac];
			changed = true;
		}
	}

	if (changed) {
		data.version = 1;
		data.updated = now;

		if (!history_write(path, data))
			return { ok: false, error: 'cannot write ' + path };
	}

	let rows = 0;

	for (let mac in data.clients)
		rows++;

	return { ok: true, path: path, rows: rows, updated: data.updated, written: changed };
}

function history_status(path) {
	let data = history_load(path);
	let online = 0, rows = 0;

	for (let mac in data.clients) {
		if (data.clients[mac].online)
			online++;

		rows++;
	}

	return {
		ok: true,
		path: path,
		exists: length(read(path)) > 0,
		rows: rows,
		online: online,
		updated: data.updated
	};
}

/* ---------------- main ---------------- */

/*
 * The retention and the path come from the caller rather than from UCI: the
 * collector script owns the schedule and the page only reads the result, so
 * keeping the config in one place avoids two sources of truth for the same
 * file.
 */
if (length(ARGV)) {
	let cmd = ARGV[0];
	let path = ARGV[1] ?? DEFAULT_HISTORY;
	let result;

	if (cmd == 'collect')
		/* false: the collector runs whether or not anyone looks at the page,
		 * and PTR resolution must follow the viewer, not the clock. */
		result = history_merge(path, snapshot(false), int(ARGV[2]) ?? 7);
	else if (cmd == 'read')
		result = history_load(path);
	else if (cmd == 'nlbw') {
		let available = nlbw_available();
		let period = (ARGV[1] != null && length(ARGV[1])) ? ARGV[1] : null;
		let usage = available ? nlbw_usage(period) : null;

		result = {
			/* Not an error: the query succeeded, the answer is "this box does not
			 * have nlbwmon". Exiting non-zero here would make the page treat a
			 * missing optional package as a broken probe. */
			ok: true,
			available: available,
			period: period,
			periods: available ? nlbw_periods() : [],
			hosts: usage ?? {}
		};
	}
	else if (cmd == 'clear')
		result = history_write(path, history_empty())
			? { ok: true, cleared: true }
			: { ok: false, error: 'cannot write ' + path };
	else if (cmd == 'status')
		result = history_status(path);
	else
		result = { ok: false, error: 'usage: clients-probe [collect|read|clear|status|nlbw] [path|period] [retention_days]' };

	print(sprintf('%J\n', result));
	exit((result.ok == false) ? 1 : 0);
}

print(sprintf('%J\n', snapshot(true)));
